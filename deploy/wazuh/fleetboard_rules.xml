<!--
  Fleetboard temperature alerts for the Wazuh manager.
  Copy to /var/ossec/etc/rules/fleetboard_rules.xml on the manager and restart it
  (systemctl restart wazuh-manager). The Fleetboard server writes one JSON line per change to
  /var/log/fleetboard/wazuh-alerts.json; the agent on that box reads it (see ossec-agent.conf.xml).

  Wazuh can't take a rule's level from the event, so there is one child rule per level: the line's
  fleetboard.level (set by the thresholds in server.toml) picks the rule, and so the alert level.
  The ids 100800-100815 are in the custom range; change them if they clash with your own rules.
-->
<group name="fleetboard,temperature,">

  <rule id="100800" level="0">
    <decoded_as>json</decoded_as>
    <field name="fleetboard.event">^temperature$</field>
    <description>Fleetboard: temperature event</description>
  </rule>

  <rule id="100801" level="1">
    <if_sid>100800</if_sid>
    <field name="fleetboard.level">^1$</field>
    <description>Fleetboard: $(fleetboard.host) $(fleetboard.sensor) is $(fleetboard.celsius) C ($(fleetboard.state), rule $(fleetboard.rule))</description>
  </rule>

